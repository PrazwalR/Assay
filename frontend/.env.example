# Optional. The public Base Sepolia endpoint serves the three reads this app makes
# (oracle reference price, hook fee bounds, block number) without a key. Set this to
# point at a provider with better rate limits — Alchemy, Infura — without a code change.
#
# NEXT_PUBLIC_ prefix is required: these reads happen in the browser.
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=

# Optional. Used only to build the absolute OG image URL in metadata (og:image must be
# absolute, or link previews on Discord/Twitter/Farcaster fail to render). Falls back to
# Vercel's own deployment URL, then localhost, so this only needs setting for a custom domain.
NEXT_PUBLIC_SITE_URL=

# Optional. Set to "true" to withhold the status banner and the two Assurance doc pages
# (Risk & known gaps, What is not built) from the built site — a presentation switch for a
# testnet demo where the banner is chrome rather than warning.
#
# Nothing is deleted: those pages, README.md and SECURITY.md keep every number unconditionally.
# Unset is the full-disclosure build, so a fresh checkout and CI always show everything, and
# restoring the deployed site is deleting this variable rather than reverting a commit.
#
# Do not set this on a deployment that could custody real value. The hook is unaudited and its
# adverse-selection gate does not currently pass; hiding that there would be a lie by omission.
NEXT_PUBLIC_DEMO_MODE=
