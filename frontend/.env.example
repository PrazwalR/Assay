# Optional. The public Base Sepolia endpoint serves the three reads this app makes
# (oracle reference price, hook fee bounds, block number) without a key. Set this to
# point at a provider with better rate limits — Alchemy, Infura — without a code change.
#
# NEXT_PUBLIC_ prefix is required: these reads happen in the browser.
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=

# Optional. Used only to build the absolute OG image URL in metadata (og:image must be
# absolute, or link previews on Discord/Twitter/Farcaster fail to render). Falls back to
# Vercel's own deployment URL, then localhost, so this only needs setting for a custom domain.
NEXT_PUBLIC_SITE_URL=
